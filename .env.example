# Copy to .env and adjust. .env is git-ignored and must never be committed.

# --- Application -----------------------------------------------------------
APP_ENV=local            # local | test | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Host-side value (running backend commands outside Docker). Inside Compose the
# api/worker services override this with the `postgres` service hostname.
DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# Optional. Default: broker = REDIS_URL, result backend = same host, db 1.
# CELERY_BROKER_URL=redis://localhost:6380/0
# CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- LLM / embeddings ------------------------------------------------------
# `stub` needs no API key: it renders narratives from an evidence template so
# tests and a fresh clone work offline. Switch to `gemini` for real narratives.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
