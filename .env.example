# Copy to .env and adjust. .env is git-ignored and must never be committed.

# --- Application -----------------------------------------------------------
APP_ENV=local            # local | test | production
LOG_LEVEL=INFO

# Origins allowed to call the API from a browser. Comma-separated, no wildcard.
# In production this must be the deployed frontend's origin; the API refuses to
# start with APP_ENV=production if it is still a localhost value.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Host-side value (running backend commands outside Docker). Inside Compose the
# api/worker services override this with the `postgres` service hostname.
DATABASE_URL=postgresql+psycopg://argus:argus@localhost:5433/argus

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
# Optional. Default: broker = REDIS_URL, result backend = same host, db 1.
# CELERY_BROKER_URL=redis://localhost:6380/0
# CELERY_RESULT_BACKEND=redis://localhost:6380/1

# --- Scoring ---------------------------------------------------------------
# Fraction of each batch that becomes an alert. Applied by ranking the batch and
# taking the top slice, never as a stored probability cutoff.
ALERT_BUDGET=0.01

# --- LLM / embeddings ------------------------------------------------------
# `stub` needs no API key: it renders narratives from an evidence template so
# tests and a fresh clone work offline. Switch to `gemini` for real narratives.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
